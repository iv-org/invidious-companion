{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeDigest"
  ],
  "timezone": "UTC",
  "schedule": ["* 0 * * 6"],
  "assignees": ["unixfox"],
  "reviewers": ["unixfox"],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Group Hono framework updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["hono", "@hono/**"],
      "groupName": "Hono framework"
    },
    {
      "description": "Group YouTube.js ecosystem updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["youtubei.js", "googlevideo", "bgutils-js"],
      "groupName": "YouTube.js ecosystem"
    },
    {
      "description": "Auto-merge patch updates for GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch"],
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge patch updates for Docker",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch"],
      "automergeType": "pr"
    }
  ]
}
